{
  "name": "preventbase",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "build:packages": "pnpm -r --filter=./packages/* build",
    "dev:api": "pnpm --filter @preventbase/api dev",
    "dev:worker": "pnpm --filter @preventbase/worker dev",
    "dev:web": "pnpm --filter @preventbase/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @preventbase/database generate",
    "db:migrate": "pnpm --filter @preventbase/database migrate:dev",
    "db:deploy": "pnpm --filter @preventbase/database migrate:deploy",
    "db:seed": "pnpm --filter @preventbase/database seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
