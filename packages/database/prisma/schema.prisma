/// eSocial somente leitura (§38): eventos importados, nunca transmitidos.
model EsocialEventRaw {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  sha256     String
  source     String // ZIP, XML, WEBSERVICE
  filename   String?
  xml        String
  importedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, sha256])
  @@map("esocial_event_raw")
}

model EsocialEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  rawId         String    @db.Uuid
  eventType     String
  eventId       String
  receipt       String?
  layoutVersion String?
  employerDoc   String?
  workerCpf     String?
  eventDate     DateTime? @db.Date
  parsed        Json
  excludedBy    String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, eventId])
  @@index([tenantId, workerCpf, eventType])
  @@map("esocial_events")
}

model EsocialSync {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  mode       String // IMPORT, WEBSERVICE
  status     String
  stats      Json?
  error      String?
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)

  @@map("esocial_sync")
}

model EsocialDivergence {
