/* =============================== documents =============================== */

model Document {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  companyId        String?      @db.Uuid
  entityType       String
  entityId         String
  category         String
  title            String
  isEvidence       Boolean      @default(false)
  currentVersion   Int          @default(1)
  createdById      String       @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  status           RecordStatus @default(ACTIVE)
  cancelledAt      DateTime?    @db.Timestamptz(3)
  cancelledById    String?      @db.Uuid

  versions DocumentVersion[]

  @@index([tenantId, entityType, entityId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @db.Uuid
  version      Int
  filename     String
  mimeType     String
  size         Int
  sha256       String
  storagePath  String
  uploadedById String   @db.Uuid
  uploadedAt   DateTime @default(now()) @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
  @@map("document_versions")
}

/* ================================= audit ================================= */

/// Hash chain por tenant (§82): currentHash = SHA-256(previousHash + canonical(entrada)).
model AuditLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @db.Uuid
  userId       String?  @db.Uuid
  action       String
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  deviceId     String?  @db.Uuid
  requestId    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  previousHash String
  currentHash  String   @unique

  @@index([tenantId, id])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  scope          String
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, scope, key])
  @@map("idempotency_records")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  companyId  String?   @db.Uuid
  type       String
  severity   String // INFO, WARNING, CRITICAL
  title      String
  body       String?
  entityType String?
  entityId   String?
  dedupeKey  String
  readAt     DateTime? @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, resolvedAt, createdAt])
  @@map("notifications")
}

/// Registro LGPD de tratamento (§57).
model DataProcessingRecord {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  purpose      String
  dataCategory String // PERSONAL, SENSITIVE_BIOMETRIC, SENSITIVE_HEALTH
  legalBasis   String
  source       String
  controller   String
  retention    String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@map("data_processing_records")
}

