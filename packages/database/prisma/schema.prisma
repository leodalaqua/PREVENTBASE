// PreventBase — modelo de dados único (MASTER-PLAN §0, §59).
// Regras: tenant em toda tabela multiempresa; timestamptz; sem delete físico de registros críticos (cancelled_*);
// estoque só por StockMovement (StockBalance é projeção mantida na mesma transação).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ============================== organization ============================== */

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("tenants")
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  legalName String
  tradeName String?
  cnpj      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  establishments Establishment[]
  jobs           Job[]
  employees      Employee[]

  @@unique([tenantId, cnpj])
  @@map("companies")
}

model Establishment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  companyId String   @db.Uuid
  name      String
  code      String?
  cnpj      String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company     Company      @relation(fields: [companyId], references: [id])
  units       Unit[]
  departments Department[]
  employees   Employee[]
  warehouses  Warehouse[]

  @@index([tenantId, companyId])
  @@map("establishments")
}

model Unit {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  companyId       String   @db.Uuid
  establishmentId String   @db.Uuid
  name            String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  departments   Department[]

  @@index([tenantId, establishmentId])
  @@map("units")
}

model Department {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  companyId       String   @db.Uuid
  establishmentId String   @db.Uuid
  unitId          String?  @db.Uuid
  name            String
  code            String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  unit          Unit?         @relation(fields: [unitId], references: [id])
  employees     Employee[]

  @@index([tenantId, establishmentId])
  @@map("departments")
}

model Job {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  companyId   String   @db.Uuid
  name        String
  cbo         String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company         Company             @relation(fields: [companyId], references: [id])
  employees       Employee[]
  epiRequirements EpiJobRequirement[]
  risks           JobRisk[]

  @@index([tenantId, companyId])
  @@map("jobs")
}

/* ================================ people ================================= */

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model Employee {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid
  companyId         String         @db.Uuid
  establishmentId   String         @db.Uuid
  unitId            String?        @db.Uuid
  departmentId      String?        @db.Uuid
  jobId             String?        @db.Uuid
  managerEmployeeId String?        @db.Uuid
  name              String
  cpf               String
  registration      String?
  birthDate         DateTime?      @db.Date
  admissionDate     DateTime?      @db.Date
  terminationDate   DateTime?      @db.Date
  cbo               String?
  status            EmployeeStatus @default(ACTIVE)
  photoDocumentId   String?        @db.Uuid
  email             String?
  phone             String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  company       Company            @relation(fields: [companyId], references: [id])
  establishment Establishment      @relation(fields: [establishmentId], references: [id])
  department    Department?        @relation(fields: [departmentId], references: [id])
  job           Job?               @relation(fields: [jobId], references: [id])
  manager       Employee?          @relation("EmployeeManager", fields: [managerEmployeeId], references: [id])
  reports       Employee[]         @relation("EmployeeManager")
  history       EmployeeHistory[]
  deliveries    EpiDelivery[]
  returns       EpiReturn[]
  biometrics    BiometricProfile[]

  @@unique([tenantId, cpf])
  @@index([tenantId, companyId, status])
  @@index([tenantId, name])
  @@map("employees")
}

model EmployeeHistory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  employeeId  String   @db.Uuid
  kind        String // ADMISSION, JOB_CHANGE, DEPARTMENT_CHANGE, ESTABLISHMENT_CHANGE, STATUS_CHANGE, DATA_CHANGE
  fromValue   Json?
  toValue     Json?
  reason      String?
  effectiveAt DateTime @db.Timestamptz(3)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, employeeId, effectiveAt])
  @@map("employee_history")
}

/* =============================== identity ================================ */

enum UserStatus {
  ACTIVE
  BLOCKED
}

/// Espelho do usuário da central Veritech (FK de auditoria/autoria), sincronizado no login único.
/// Acesso e senha ficam só na central: passwordHash é aleatório e sem uso.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  email        String     @unique
  cpf          String?    @unique
  name         String
  passwordHash String
  status       UserStatus @default(ACTIVE)
  mfaSecret    String?
  mfaEnabled   Boolean    @default(false)
  employeeId   String?    @db.Uuid
  lastLoginAt  DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  roles    UserRole[]
  sessions Session[]

  /// Legado (passkey local removida; biometria de login só na central).
  webauthnUserHandle String?              @unique
  passkeys           WebauthnCredential[]

  @@index([tenantId])
  @@map("users")
}

/// Legado: passkey local removida (biometria de login só na central).
model WebauthnCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  credentialId String    @unique
  publicKey    String
  signCount    Int       @default(0)
  transports   String[]  @default([])
  deviceName   String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

/// Legado: perfis/permissões locais sem uso (acesso só pela central Veritech). Tabelas mantidas por histórico.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  key         String
  name        String
  system      Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, key])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String  @db.Uuid
  roleId          String  @db.Uuid
  companyId       String? @db.Uuid
  establishmentId String? @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@index([userId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  deviceId         String?   @db.Uuid
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  rotatedAt        DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  revokedReason    String?
  /// Sessão central do login único Veritech (C:\ROBBY\docs\robby\sso-veritech.md); conferida no refresh.
  ssoSid           String?
  /// isAdmin/permissoes da central (redeem ou /sso/check na renovação): única fonte de autorização.
  ssoIsAdmin       Boolean   @default(false)
  ssoPermissoes    Json?
  /// Entrou com segundo fator na central (dispensou o TOTP do app).
  ssoMfa           Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

enum DeviceStatus {
  PENDING
  TRUSTED
  BLOCKED
}

model Device {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  companyId         String?      @db.Uuid
  establishmentId   String?      @db.Uuid
  deviceKeyHash     String
  name              String
  model             String?
  platform          String?
  responsibleUserId String?      @db.Uuid
  status            DeviceStatus @default(PENDING)
  approvedById      String?      @db.Uuid
  approvedAt        DateTime?    @db.Timestamptz(3)
  lastSeenAt        DateTime?    @db.Timestamptz(3)
  lastIp            String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, deviceKeyHash])
  @@map("devices")
}

/* ================================== EPI ================================== */

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

model EpiProduct {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  internalCode     String
  description      String
  category         String
  brand            String?
  model            String?
  manufacturer     String?
  protectionType   String?
  replacementDays  Int?
  unit             String       @default("UN")
  color            String?
  notes            String?
  reusable         Boolean      @default(false)
  requiresReturn   Boolean      @default(false)
  unitCost         Decimal?     @db.Decimal(14, 4)
  guidance         Json         @default("{}")
  manualDocumentId String?      @db.Uuid
  imageDocumentId  String?      @db.Uuid
  status           ActiveStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  variants     EpiVariant[]
  cas          EpiProductCa[]
  requirements EpiJobRequirement[]
  kitItems     EpiKitItem[]

  @@unique([tenantId, internalCode])
  @@index([tenantId, description])
  @@map("epi_products")
}

model EpiVariant {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  productId String   @db.Uuid
  size      String?
  color     String?
  sku       String
  ean       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  product EpiProduct   @relation(fields: [productId], references: [id])
  lots    StockLot[]
  levels  StockLevel[]

  @@unique([tenantId, sku])
  @@index([tenantId, ean])
  @@map("epi_variants")
}

/// Histórico de CAs vinculados ao produto (§10 regra "CA deve guardar histórico").
model EpiProductCa {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  productId   String    @db.Uuid
  caNumber    String
  isCurrent   Boolean   @default(true)
  linkedAt    DateTime  @default(now()) @db.Timestamptz(3)
  unlinkedAt  DateTime? @db.Timestamptz(3)
  linkedById  String?   @db.Uuid

  product EpiProduct @relation(fields: [productId], references: [id])

  @@index([tenantId, caNumber])
  @@index([productId, isCurrent])
  @@map("epi_ca")
}

model EpiJobRequirement {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  jobId           String   @db.Uuid
  productId       String   @db.Uuid
  quantity        Int      @default(1)
  replacementDays Int?
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  job     Job        @relation(fields: [jobId], references: [id])
  product EpiProduct @relation(fields: [productId], references: [id])

  @@unique([jobId, productId])
  @@map("epi_job_requirements")
}

model EpiKit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  items EpiKitItem[]

  @@unique([tenantId, name])
  @@map("epi_kits")
}

model EpiKitItem {
  id        String @id @default(uuid()) @db.Uuid
  kitId     String @db.Uuid
  productId String @db.Uuid
  quantity  Int    @default(1)

  kit     EpiKit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  product EpiProduct @relation(fields: [productId], references: [id])

  @@unique([kitId, productId])
  @@map("epi_kit_items")
}

model DeliveryReason {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  code                  String
  name                  String
  requiresJustification Boolean  @default(false)
  active                Boolean  @default(true)
  sortOrder             Int      @default(100)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, code])
  @@map("delivery_reasons")
}

model DeliveryTerms {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  version     Int
  text        String
  textHash    String
  active      Boolean  @default(true)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, version])
  @@map("delivery_terms")
}

/* =========================== CA / CAEPI (global) ========================== */

model CaManufacturer {
  cnpj      String   @id
  name      String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("ca_manufacturer")
}

/// Espelho da base oficial CAEPI/MTE (dado público, compartilhado entre tenants).
model CaMaster {
  caNumber             String    @id
  validUntil           DateTime? @db.Date
  situation            String?
  processNumber        String?
  manufacturerCnpj     String?
  manufacturerName     String?
  nature               String?
  equipmentName        String?
  equipmentDescription String?
  brand                String?
  reference            String?
  color                String?
  approvedFor          String?
  restrictions         String?
  observations         String?
  labCnpj              String?
  labName              String?
  reportNumber         String?
  standard             String?
  rowHash              String
  syncId               String?   @db.Uuid
  syncedAt             DateTime  @db.Timestamptz(3)

  history CaHistory[]

  @@index([manufacturerCnpj])
  @@map("ca_master")
}

model CaHistory {
  id            String   @id @default(uuid()) @db.Uuid
  caNumber      String
  syncId        String?  @db.Uuid
  changedFields String[]
  previous      Json?
  current       Json
  changedAt     DateTime @default(now()) @db.Timestamptz(3)

  ca CaMaster @relation(fields: [caNumber], references: [caNumber])

  @@index([caNumber, changedAt])
  @@map("ca_history")
}

model CaSync {
  id           String    @id @default(uuid()) @db.Uuid
  source       String
  status       String // RUNNING, DONE, FAILED
  fileHash     String?
  rowsRead     Int       @default(0)
  inserted     Int       @default(0)
  updated      Int       @default(0)
  unchanged    Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime? @db.Timestamptz(3)
  triggeredBy  String?

  @@map("ca_sync")
}

/* =============================== inventory =============================== */

enum WarehouseKind {
  CENTRAL
  UNIT
  SECTOR
}

model Warehouse {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  companyId       String        @db.Uuid
  establishmentId String        @db.Uuid
  name            String
  code            String
  kind            WarehouseKind @default(CENTRAL)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  establishment Establishment   @relation(fields: [establishmentId], references: [id])
  locations     StockLocation[]
  balances      StockBalance[]

  @@unique([tenantId, code])
  @@map("warehouses")
}

model StockLocation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  warehouseId String   @db.Uuid
  code        String
  description String?
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  balances  StockBalance[]

  @@unique([warehouseId, code])
  @@map("stock_locations")
}

model StockLot {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  companyId            String    @db.Uuid
  productId            String    @db.Uuid
  variantId            String    @db.Uuid
  lotNumber            String
  caNumber             String
  manufactureDate      DateTime? @db.Date
  expiryDate           DateTime? @db.Date
  purchaseDate         DateTime  @db.Date
  /// Validade do CA conhecida na data da compra (§19).
  caValidityAtPurchase DateTime? @db.Date
  /// CA válido no momento da compra? null = não foi possível verificar.
  caValidAtPurchase    Boolean?
  unitCost             Decimal?  @db.Decimal(14, 4)
  supplier             String?
  invoiceNumber        String?
  publicCode           String    @unique
  createdById          String?   @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  variant  EpiVariant     @relation(fields: [variantId], references: [id])
  balances StockBalance[]

  @@unique([tenantId, variantId, lotNumber, caNumber])
  @@index([tenantId, variantId, expiryDate])
  @@map("stock_lots")
}

enum MovementType {
  ENTRY
  DELIVERY
  DELIVERY_CANCEL
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  LOSS
  DISPOSAL
  INVENTORY_IN
  INVENTORY_OUT
}

/// Imutável. quantity com sinal (+ entra, - sai). Saldo = soma dos movimentos.
model StockMovement {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  companyId       String       @db.Uuid
  establishmentId String       @db.Uuid
  warehouseId     String       @db.Uuid
  locationId      String       @db.Uuid
  lotId           String       @db.Uuid
  variantId       String       @db.Uuid
  type            MovementType
  quantity        Int
  balanceAfter    Int
  unitCost        Decimal?     @db.Decimal(14, 4)
  referenceType   String?
  referenceId     String?      @db.Uuid
  reason          String?
  createdById     String?      @db.Uuid
  requestId       String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([lotId])
  @@index([warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

/// Projeção do saldo por (almoxarifado, localização, lote). Só alterada pelo serviço de movimentos.
model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  warehouseId String   @db.Uuid
  locationId  String   @db.Uuid
  lotId       String   @db.Uuid
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  location  StockLocation @relation(fields: [locationId], references: [id])
  lot       StockLot      @relation(fields: [lotId], references: [id])

  @@unique([warehouseId, locationId, lotId])
  @@index([tenantId, lotId])
  @@map("stock_balances")
}

model StockLevel {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  warehouseId  String   @db.Uuid
  variantId    String   @db.Uuid
  minQty       Int      @default(0)
  maxQty       Int?
  leadTimeDays Int?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  variant EpiVariant @relation(fields: [variantId], references: [id])

  @@unique([warehouseId, variantId])
  @@map("stock_levels")
}

model StockTransfer {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  fromWarehouseId String   @db.Uuid
  toWarehouseId   String   @db.Uuid
  notes           String?
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("stock_transfers")
}

enum InventoryStatus {
  OPEN
  COUNTING
  DIVERGENT
  APPROVED
  CLOSED
  CANCELLED
}

model InventoryCount {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid
  warehouseId  String          @db.Uuid
  status       InventoryStatus @default(OPEN)
  doubleCount  Boolean         @default(false)
  notes        String?
  openedById   String?         @db.Uuid
  approvedById String?         @db.Uuid
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  startedAt    DateTime?       @db.Timestamptz(3)
  approvedAt   DateTime?       @db.Timestamptz(3)
  closedAt     DateTime?       @db.Timestamptz(3)

  items InventoryCountItem[]

  @@index([tenantId, status])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id          String   @id @default(uuid()) @db.Uuid
  countId     String   @db.Uuid
  lotId       String   @db.Uuid
  locationId  String   @db.Uuid
  systemQty   Int
  count1      Int?
  count1ById  String?  @db.Uuid
  count2      Int?
  count2ById  String?  @db.Uuid
  finalQty    Int?

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, lotId, locationId])
  @@map("inventory_count_items")
}

/* =============================== deliveries ============================== */

enum RecordStatus {
  ACTIVE
  CANCELLED
}

/// Entrega de EPI — imutável (§52). Cancelamento preserva o original.
model EpiDelivery {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  companyId          String       @db.Uuid
  establishmentId    String       @db.Uuid
  departmentId       String?      @db.Uuid
  jobId              String?      @db.Uuid
  employeeId         String       @db.Uuid
  managerUserId      String       @db.Uuid
  deviceId           String?      @db.Uuid
  warehouseId        String       @db.Uuid
  publicId           String       @unique
  idempotencyKey     String
  status             RecordStatus @default(ACTIVE)
  deliveredAt        DateTime     @db.Timestamptz(3)
  cancelledAt        DateTime?    @db.Timestamptz(3)
  cancelledById      String?      @db.Uuid
  cancellationReason String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)

  employee Employee          @relation(fields: [employeeId], references: [id])
  items    EpiDeliveryItem[]
  evidence DeliveryEvidence?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, deliveredAt])
  @@index([employeeId, deliveredAt])
  @@map("epi_deliveries")
}

model EpiDeliveryItem {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  deliveryId         String    @db.Uuid
  employeeId         String    @db.Uuid
  productId          String    @db.Uuid
  variantId          String    @db.Uuid
  lotId              String    @db.Uuid
  productDescription String
  caNumber           String
  manufacturer       String?
  lotNumber          String
  lotExpiryDate      DateTime? @db.Date
  caValidAtPurchase  Boolean?
  quantity           Int
  reasonCode         String
  justification      String?
  isEarlyReplacement Boolean   @default(false)
  replacesItemId     String?   @db.Uuid
  nextReplacementDue DateTime? @db.Date
  unitCost           Decimal?  @db.Decimal(14, 4)
  stockMovementId    String    @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  delivery EpiDelivery @relation(fields: [deliveryId], references: [id])

  @@index([tenantId, employeeId, productId])
  @@map("epi_delivery_items")
}

/// Pacote probatório (§11). hash = SHA-256 do canonicalPayload.
model DeliveryEvidence {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @db.Uuid
  deliveryId              String   @unique @db.Uuid
  verificationMethod      String
  biometricVerificationId String
  biometricScore          Float
  livenessResult          Boolean
  livenessChallenge       String?
  termsVersion            Int
  termsTextHash           String
  ipAddress               String?
  userAgent               String?
  sessionId               String?  @db.Uuid
  deviceId                String?  @db.Uuid
  requestId               String?
  canonicalPayload        Json
  hashAlgorithm           String   @default("SHA-256")
  hash                    String
  createdAt               DateTime @default(now()) @db.Timestamptz(3)

  delivery EpiDelivery @relation(fields: [deliveryId], references: [id])

  @@map("delivery_evidence")
}

enum ReturnCondition {
  GOOD
  WORN
  DAMAGED
  CONTAMINATED
}

enum ReturnDestination {
  REUSABLE
  SANITIZATION
  MAINTENANCE
  DISCARDED
}

model EpiReturn {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  companyId          String            @db.Uuid
  establishmentId    String            @db.Uuid
  employeeId         String            @db.Uuid
  deliveryItemId     String?           @db.Uuid
  variantId          String            @db.Uuid
  lotId              String?           @db.Uuid
  warehouseId        String            @db.Uuid
  quantity           Int
  condition          ReturnCondition
  destination        ReturnDestination
  reason             String
  notes              String?
  stage              String // RECEIVED, SANITIZATION, MAINTENANCE, INSPECTION, RELEASED, DISCARDED
  stockMovementId    String?           @db.Uuid
  receivedById       String            @db.Uuid
  returnedAt         DateTime          @default(now()) @db.Timestamptz(3)
  status             RecordStatus      @default(ACTIVE)
  cancelledAt        DateTime?         @db.Timestamptz(3)
  cancelledById      String?           @db.Uuid
  cancellationReason String?

  employee Employee         @relation(fields: [employeeId], references: [id])
  steps    EpiReturnStep[]

  @@index([tenantId, returnedAt])
  @@map("epi_returns")
}

model EpiReturnStep {
  id            String   @id @default(uuid()) @db.Uuid
  returnId      String   @db.Uuid
  step          String
  notes         String?
  performedById String   @db.Uuid
  performedAt   DateTime @default(now()) @db.Timestamptz(3)

  epiReturn EpiReturn @relation(fields: [returnId], references: [id])

  @@map("epi_return_steps")
}

/* =============================== biometric =============================== */
// O template NÃO fica aqui: vive cifrado no biometric-service (§8). Aqui só referência e resultados.

model BiometricProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  employeeId         String       @db.Uuid
  externalProfileId  String
  status             RecordStatus @default(ACTIVE)
  quality            Float?
  purpose            String
  legalBasis         String
  enrolledById       String       @db.Uuid
  deviceId           String?      @db.Uuid
  enrolledAt         DateTime     @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?    @db.Timestamptz(3)
  revokedById        String?      @db.Uuid
  revocationReason   String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId, employeeId, status])
  @@map("biometric_profiles")
}

model BiometricVerification {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid
  employeeId             String    @db.Uuid
  externalVerificationId String    @unique
  purpose                String
  verified               Boolean
  score                  Float
  liveness               Boolean
  challengeAction        String?
  reason                 String?
  deviceId               String?   @db.Uuid
