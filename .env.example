# PreventBase — copie para .env (nunca versionar .env). Portas: C:\ROBBY\config\ports.json (id 31).

# Portas publicadas no host
PREVENTBASE_WEB_PORT=3100
PREVENTBASE_API_PORT=3101
PREVENTBASE_PG_PORT=3110
PREVENTBASE_MINIO_API_PORT=3112
PREVENTBASE_MINIO_CONSOLE_PORT=3113

# Postgres (rede interna do compose)
POSTGRES_USER=preventbase
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=preventbase
# Uso no host (prisma migrate dev / pnpm dev): aponta para a porta publicada
DATABASE_URL=postgresql://preventbase:change-me-postgres@localhost:3110/preventbase?schema=public

# Redis (interno)
REDIS_URL=redis://localhost:6379

# MinIO (interno)
MINIO_ROOT_USER=preventbase
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_ENDPOINT=localhost
MINIO_PORT=3112
MINIO_USE_SSL=false
MINIO_BUCKET=preventbase-documents

# Auth
JWT_SECRET=change-me-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14

# Login único Veritech (C:\ROBBY\docs\robby\sso-veritech.md). App SSO fixo no servidor: preventbase.
VERITECH_SSO_URL=https://servidor.taild57d57.ts.net
# Host (pnpm dev). No Docker o compose usa http://host.docker.internal:2922.
VERITECH_SSO_INTERNAL_URL=http://127.0.0.1:2922
# 0 = só login único (desliga e-mail/senha local)
VERITECH_SSO_LOCAL_LOGIN=1

# Biometria (serviço isolado; API principal nunca lê o template)
BIOMETRIC_SERVICE_URL=http://localhost:8000
BIOMETRIC_SERVICE_TOKEN=change-me-service-token
# 32 bytes em base64 (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BIOMETRIC_TEMPLATE_KEY=
BIOMETRIC_MATCH_THRESHOLD=0.363

# URL pública usada em QR Codes de verificação (tailnet HTTPS)
PUBLIC_BASE_URL=https://servidor.taild57d57.ts.net:13100

# CAEPI (base oficial MTE). Vazio = só importação manual do arquivo.
CAEPI_SOURCE_URL=ftp://ftp.mtps.gov.br/portal/fiscalizacao/seguranca-e-saude-no-trabalho/caepi/tgg_export_caepi.zip

# Seed inicial (só primeira execução)
SEED_ADMIN_EMAIL=admin@preventbase.local
SEED_ADMIN_PASSWORD=change-me-admin
SEED_TENANT_NAME=Grupo Veritech

# Backup
BACKUP_RETENTION_DAYS=14
